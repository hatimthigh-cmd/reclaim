# ===================== Reclaim-Retest v2 bot settings =====================
# Copy this file to ".env" and fill in the two Telegram lines. Everything else is optional.

# --- Telegram (required) ---
# Create a bot with @BotFather and paste its token. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Reply to /status /watch /pending /open /stats /rules /help (only from TELEGRAM_CHAT_ID)
TELEGRAM_COMMANDS=true

# --- Strategy (defaults = backtested v2 rules; change only if you know why) ---
PUMP_MIN_PCT=40          # high >= 40% above the lowest low of the previous 7 days
PUMP_LOOKBACK_H=120      # the high = highest high of the last 120 1h candles
BASE_LOOKBACK_H=168      # the 7-day low = lowest low of the 168 candles before that high
DUMP_MIN_PCT=25          # flush low >= 25% below the high
FLUSH_ATR_MIN=2.0        # capitulation: flush candle range >= 2 x ATR(14)
RECLAIM_WINDOW_H=8       # reclaim must happen within 8 candles of the flush low
EMA_LEN=200              # 1h EMA used for the reclaim and as the buy-limit price
ATR_LEN=14
ATR_MULT=1.5             # SL = entry - 1.5 x ATR
TP_R=1.5                 # TP = entry + 1.5 x (entry - SL)
MAX_STOP_PCT=12          # skip / pause when the stop would be wider than 12%
ORDER_VALID_H=48         # cancel the buy limit after 48h without a fill
MAX_HOLD_H=168           # close at market after 7 days
COST_PCT=0.10            # round-trip fees + slippage used in R statistics

# --- Early alerts (before the 1h candle closes) ---
EARLY_ENABLED=true
EARLY_START_MIN=10       # start checking 10 minutes before the close
EARLY_END_MIN=3          # stop checking 3 minutes before the close
EARLY_BUFFER_PCT=0.3     # price must be >= 0.3% above the EMA200 to send an early alert
EARLY_POLL_SEC=20        # how often to re-check inside the early window

# --- Which alerts to send ---
ALERT_WATCH=true         # coin pumped + flushed + capitulation candle, waiting for the reclaim
ALERT_EARLY=true         # trigger likely at this candle's close (also sends EARLY CANCELLED)
ALERT_TRIGGER=true       # confirmed: place the buy limit
ALERT_LEVEL_UPDATE=true  # the buy limit moved (EMA200 changed), or paused/resumed
LEVEL_UPDATE_MIN_PCT=0.5 # only report level moves of at least 0.5%
ALERT_FILL=true          # limit filled: exact SL and TP
ALERT_EXIT=true          # TP hit / SL hit / 7-day time exit
ALERT_EXPIRE=true        # no fill within ORDER_VALID_H
ALERT_SKIP=false         # level reached while the stop was too wide

# --- Position-size suggestions in the alerts ---
ACCOUNT_USD=1000
RISK_PCT=1               # % of account risked per trade
RISK_USD=0               # if > 0, overrides RISK_PCT (e.g. 10 = always risk $10)
MAX_LEVERAGE=10          # never suggest more than this
LIQ_BUFFER_PCT=2         # keep liquidation at least (stop % + 2%) away
MAX_OPEN_TRADES=0        # 0 = no cap; otherwise ignore new triggers above this many pending/open

# --- Which coins ---
QUOTE_ASSET=USDT
MIN_QUOTE_VOLUME_24H=0   # e.g. 5000000 to ignore coins with < $5M 24h volume (0 = all, like the backtest)
INCLUDE_SYMBOLS=         # e.g. ARIAUSDT,BTWUSDT  (empty = all)
EXCLUDE_SYMBOLS=         # e.g. BTCUSDT,ETHUSDT
MIN_HISTORY_H=400        # skip coins with fewer 1h candles than this (new listings)
UNIVERSE_REFRESH_H=6     # re-read the coin list every N hours (picks up new listings, drops delisted coins)

# --- Runtime ---
MONITOR_POLL_SEC=15      # price checks for fills and SL/TP
HISTORY_BARS=1000        # 1h candles kept per coin (400-1500)
CLOSE_DELAY_SEC=5        # seconds after each hour before reading the closed candle
TZ_OFFSET_HOURS=5        # times in messages (5 = Pakistan time)
TZ_LABEL=PKT
DB_PATH=reclaim_bot.sqlite3
LOG_LEVEL=INFO
